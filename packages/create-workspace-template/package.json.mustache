{
  "name": "{{slug}}",
  "version": "0.1.0",
  "packageManager": "bun@1.3.11",
  "description": "{{description}}",
  "author": "{{author}}",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "sync": "ttsx scripts/sync-project.ts",
    "sync-types": "ttsx scripts/sync-types-to-block-json.ts",
    "sync-rest": "ttsx scripts/sync-rest-contracts.ts",
    "sync-rest:package": "ttsx scripts/sync-rest-contracts.ts --package",
    "sync-rest:package:check": "ttsx scripts/sync-rest-contracts.ts --package --check",
    "wp-typia:sync": "wp-typia sync",
    "wp-typia:doctor": "wp-typia doctor",
    "wp-typia:doctor:workspace": "wp-typia doctor --workspace-only",
    "wp-typia:add": "wp-typia add",
    "build": "bun run sync --check && node scripts/build-workspace.mjs build",
    "start": "bun run sync && node scripts/build-workspace.mjs start",
    "dev": "bun run start",
    "typecheck": "bun run sync --check && ttsc --noEmit",
    "lint:ts": "ttsc --noEmit",
    "lint:js": "node scripts/run-wp-scripts-lint-js-compat.mjs",
    "lint:css": "wp-scripts lint-style",
    "lint": "bun run lint:ts && bun run lint:js && bun run lint:css",
    "format": "ttsc format --singleThreaded && prettier --write --no-error-on-unmatched-pattern \"**/*.{cjs,css,js,json,md,mjs,scss,yaml,yml}\""
  },
  "wpTypia": {
    "projectType": "workspace",
    "templatePackage": "@wp-typia/create-workspace-template",
    "namespace": "{{namespace}}",
    "textDomain": "{{textDomain}}",
    "phpPrefix": "{{phpPrefix}}"
  },
  "devDependencies": {
    "@wp-typia/api-client": "{{apiClientPackageVersion}}",
    "@wp-typia/block-runtime": "{{blockRuntimePackageVersion}}",
    "@wp-typia/block-types": "{{blockTypesPackageVersion}}",
    "@wp-typia/project-tools": "{{projectToolsPackageVersion}}",
    "@wp-typia/rest": "{{restPackageVersion}}",
    "wp-typia": "{{wpTypiaPackageVersion}}",
    "@ttsc/lint": "^0.22.0",
    "@ttsc/unplugin": "^0.22.0",
    "@typescript/typescript6": "6.0.2",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/wordpress__block-editor": "^11.5.17",
    "@types/wordpress__blocks": "^12.5.18",
    "@wordpress/browserslist-config": "^6.42.0",
    "@wordpress/scripts": "^30.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ttsc": "^0.22.0",
    "typescript": "^7.0.2",
    "typia": "^13.2.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.42.0",
    "@wordpress/block-editor": "~15.19.0",
    "@wordpress/blocks": "~15.19.0",
    "@wordpress/components": "^30.2.0",
    "@wordpress/data": "~10.46.0",
    "@wordpress/editor": "~14.46.0",
    "@wordpress/element": "^6.29.0",
    "@wordpress/i18n": "^6.2.0",
    "@wordpress/interactivity": "^6.29.0",
    "@wordpress/plugins": "~7.46.0"
  }
}
