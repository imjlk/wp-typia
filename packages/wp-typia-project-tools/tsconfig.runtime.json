{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist/runtime",
    "rootDir": "./src/runtime",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@wp-typia/block-runtime/blocks": [
        "../wp-typia-block-runtime/dist/blocks.d.ts"
      ],
      "@wp-typia/block-runtime/schema-core": [
        "../wp-typia-block-runtime/dist/schema-core.d.ts"
      ],
      "@wp-typia/block-runtime/migration-types": [
        "../wp-typia-block-runtime/dist/migration-types.d.ts"
      ],
      "@wp-typia/block-runtime/defaults": [
        "../wp-typia-block-runtime/dist/defaults.d.ts"
      ],
      "@wp-typia/block-runtime/editor": [
        "../wp-typia-block-runtime/dist/editor.d.ts"
      ],
      "@wp-typia/block-runtime/inspector": [
        "../wp-typia-block-runtime/dist/inspector.d.ts"
      ],
      "@wp-typia/block-runtime/metadata-core": [
        "./build-shims/block-runtime-metadata-core-shim.d.ts"
      ],
      "@wp-typia/block-runtime/metadata-analysis": [
        "../wp-typia-block-runtime/dist/metadata-analysis.d.ts"
      ],
      "@wp-typia/block-runtime/metadata-model": [
        "../wp-typia-block-runtime/dist/metadata-model.d.ts"
      ],
      "@wp-typia/block-runtime/metadata-parser": [
        "../wp-typia-block-runtime/dist/metadata-parser.d.ts"
      ],
      "@wp-typia/block-runtime/metadata-php-render": [
        "../wp-typia-block-runtime/dist/metadata-php-render.d.ts"
      ],
      "@wp-typia/block-runtime/metadata-projection": [
        "../wp-typia-block-runtime/dist/metadata-projection.d.ts"
      ],
      "@wp-typia/block-runtime/validation": [
        "../wp-typia-block-runtime/dist/validation.d.ts"
      ],
      "@wp-typia/block-runtime/json-utils": [
        "../wp-typia-block-runtime/dist/json-utils.d.ts"
      ]
    }
  },
  "include": [
    "./src/runtime/**/*",
    "./build-shims/**/*.d.ts"
  ],
  "exclude": [
    "./tests/**/*"
  ]
}
