const repairs = [
	prepareSourcePatches({
		description: 'mapped/infer type-parameter',
		replacements: [
			{
				expectedOccurrences: 1,
				patchedSource: patchedParentGuard,
				unpatchedSource: unpatchedParentGuard,
			},
		],
		sourcePath: lintRulePath,
	}),
	prepareSourcePatches({
		description: 'Node Buffer generic',
		replacements: [
			{
				expectedOccurrences: 2,
				patchedSource: patchedBufferTarget,
				unpatchedSource: unpatchedBufferTarget,
			},
			{
				expectedOccurrences: 2,
				patchedSource: patchedWindowsBufferTarget,
				unpatchedSource: unpatchedWindowsBufferTarget,
			},
		],
		sourcePath: lintIndexPath,
	}),
];

for (const { nextSource, sourcePath } of repairs) {
	const source = fs.readFileSync(sourcePath, 'utf8');
	if (source === nextSource) {
		continue;
	}
	const temporaryPath = `${sourcePath}.wp-typia-${process.pid}.tmp`;
	try {
		fs.writeFileSync(temporaryPath, nextSource, {
			encoding: 'utf8',
			mode: fs.statSync(sourcePath).mode,
		});
		fs.renameSync(temporaryPath, sourcePath);
	} finally {
		fs.rmSync(temporaryPath, { force: true });
	}
}
