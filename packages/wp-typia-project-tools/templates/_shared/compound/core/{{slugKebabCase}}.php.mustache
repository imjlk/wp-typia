if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

function {{phpPrefix}}_load_textdomain() {
	load_plugin_textdomain(
		'{{textDomain}}',
		false,
		dirname( plugin_basename( __FILE__ ) ) . '/languages'
	);
}

function {{phpPrefix}}_get_build_root() {
	return __DIR__ . '/build/blocks';
}

function {{phpPrefix}}_register_blocks() {
	$build_root = {{phpPrefix}}_get_build_root();
	if ( ! is_dir( $build_root ) ) {
		return;
	}

	$parent_block_dir = $build_root . '/{{slugKebabCase}}';
	$child_block_dir  = $build_root . '/{{slugKebabCase}}-item';

	if ( file_exists( $parent_block_dir . '/block.json' ) ) {
		register_block_type( $parent_block_dir );
	}
	if ( file_exists( $child_block_dir . '/block.json' ) ) {
		register_block_type( $child_block_dir );
	}
	// add-child: register generated child blocks here
}

add_action( 'init', '{{phpPrefix}}_load_textdomain' );
add_action( 'init', '{{phpPrefix}}_register_blocks' );
