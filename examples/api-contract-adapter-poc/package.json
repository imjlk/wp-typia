{
  "name": "api-contract-adapter-poc",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.11",
  "description": "Non-PHP adapter proof of concept for wp-typia REST endpoint manifests",
  "author": "imjlk",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "sync-typia-llm": "ttsx scripts/sync-typia-llm.ts",
    "build": "bun run check:code",
    "start": "ttsx src/server.ts",
    "check:code": "bun run sync-typia-llm --check && ttsc check --noEmit",
    "check": "bun run check:code",
    "format": "ttsc format --singleThreaded && prettier --write --no-error-on-unmatched-pattern \"package.json\" \"src/**/*.json\" \"tsconfig*.json\""
  },
  "devDependencies": {
    "@ttsc/lint": "^0.26.1",
    "@wp-typia/api-client": "workspace:*",
    "@wp-typia/block-runtime": "workspace:*",
    "@types/node": "^24.0.0",
    "@wp-typia/project-tools": "workspace:*",
    "prettier": "3.8.2",
    "ttsc": "^0.26.1",
    "typescript": "^7.0.2",
    "typia": "^13.2.0"
  }
}
